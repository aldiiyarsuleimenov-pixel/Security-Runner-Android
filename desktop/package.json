{
  "name": "security-runner-desktop",
  "version": "1.3.0",
  "description": "Security Runner для ПК (Electron)",
  "main": "main.js",
  "private": true,
  "author": "Security Runner",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.securityrunner.game",
    "productName": "Security Runner",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": ["portable"],
      "artifactName": "Security-Runner-${version}-portable.exe"
    }
  }
}
